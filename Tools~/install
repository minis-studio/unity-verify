#!/bin/bash
# Add dev.minis.unity-verify to a Unity project.
#
# Run from the project root, either from a checkout of the package:
#
#     path/to/unity-verify/Tools~/install
#
# or straight from GitHub:
#
#     curl -fsSL https://raw.githubusercontent.com/minis-studio/unity-verify/main/Tools~/install | bash
#
# It pins the package in Packages/manifest.json, writes the ./unity-verify shim
# and prints the AGENTS.md snippet. Re-run it with --version to upgrade.

set -u

PACKAGE=dev.minis.unity-verify
GIT_URL=https://github.com/minis-studio/unity-verify.git
RAW_URL=https://raw.githubusercontent.com/minis-studio/unity-verify
SHIM_NAME=unity-verify
SHIM_MARKER="# unity-verify shim."
EXIT_FAILURE=3

usage() {
  cat <<EOF
usage: install [--version REF] [--project-path PATH] [--force]

Add $PACKAGE to a Unity project.

  --version REF        git tag, branch or commit to pin (default: the latest release)
  --project-path PATH  Unity project root (default: the current directory)
  --force              replace an existing ./$SHIM_NAME that is not a shim
EOF
}

ref=""
project_path=.
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --version) [ $# -ge 2 ] || { usage >&2; exit 2; }; ref=$2; shift 2 ;;
    --version=*) ref=${1#*=}; shift ;;
    --project-path) [ $# -ge 2 ] || { usage >&2; exit 2; }; project_path=$2; shift 2 ;;
    --project-path=*) project_path=${1#*=}; shift ;;
    --force) force=1; shift ;;
    *) usage >&2; echo "install: unrecognized argument: $1" >&2; exit 2 ;;
  esac
done

root=$(cd "$project_path" 2>/dev/null && pwd -P) || root=$project_path
manifest="$root/Packages/manifest.json"
if [ ! -f "$manifest" ] || [ ! -f "$root/ProjectSettings/ProjectVersion.txt" ]; then
  echo "ERR project_missing; path=$root; fix=run from a Unity project root" >&2
  exit "$EXIT_FAILURE"
fi

# The package checkout this installer runs from, or nothing when it is piped.
checkout=""
if [ -f "${BASH_SOURCE[0]:-}" ]; then
  checkout=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
  [ -f "$checkout/Tools~/project-shim" ] || checkout=""
fi

package_file() {  # REF PATH
  if [ -n "$checkout" ]; then
    cat "$checkout/$2"
  else
    curl -fsSL "$RAW_URL/$1/$2"
  fi
}

fetch_failed() {
  echo "ERR package_fetch; cause=could not read $1; fix=check network or --version" >&2
  exit "$EXIT_FAILURE"
}

if [ -z "$ref" ]; then
  version=$(package_file main package.json | sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
  [ -n "$version" ] || fetch_failed package.json
  ref="v$version"
fi
spec="$GIT_URL#$ref"
shim=$(package_file "$ref" "Tools~/project-shim") || fetch_failed "Tools~/project-shim at $ref"
snippet=$(package_file "$ref" "Tools~/agents-snippet.md") || fetch_failed "Tools~/agents-snippet.md at $ref"

shim_path="$root/$SHIM_NAME"
if [ -e "$shim_path" ] && [ "$force" = 0 ] && ! grep -qF "$SHIM_MARKER" "$shim_path"; then
  echo "ERR shim_exists; path=$shim_path; fix=rerun with --force to replace it (it is not a unity-verify shim)" >&2
  exit "$EXIT_FAILURE"
fi

previous=$(grep -F "\"$PACKAGE\"" "$manifest" | head -n 1 | cut -d '"' -f 4)
if [ "$previous" != "$spec" ]; then
  # Pin the package in "dependencies", keeping the file's formatting: replace
  # its entry, or add one before the first name that sorts after it.
  updated=$(awk -v package="$PACKAGE" -v spec="$spec" '
    function entry(indent, comma) { return indent "\"" package "\": \"" spec "\"" comma }
    function flush() { if (held != "") { print held; held = "" } }
    state == 0 && /"dependencies"[ \t]*:[ \t]*\{[ \t]*\}/ {
      indent = $0; sub(/[^ \t].*$/, "", indent)
      line = $0; sub(/\{[ \t]*\}/, "{", line); print line
      print entry(indent indent, ""); sub(/"dependencies".*$/, "}", line); print line
      state = 2; next
    }
    state == 0 && /"dependencies"[ \t]*:[ \t]*\{[ \t]*$/ { print; state = 1; next }
    state == 1 && /^[ \t]*\}/ {
      if (!done) {
        if (held != "") { sub(/[ \t]*$/, "", held); if (held !~ /,$/) held = held ","; flush() }
        print entry(inner == "" ? "    " : inner, "")
        done = 1
      }
      flush(); print; state = 2; next
    }
    state == 1 {
      if (inner == "") { inner = $0; sub(/[^ \t].*$/, "", inner) }
      key = $0; sub(/^[ \t]*"/, "", key); sub(/".*$/, "", key)
      if (key == package) { flush(); held = entry(inner, $0 ~ /,[ \t]*$/ ? "," : ""); done = 1; next }
      if (!done && key > package) { flush(); print entry(inner, ","); done = 1 }
      flush(); held = $0; next
    }
    { print }
  ' "$manifest") || exit "$EXIT_FAILURE"
  printf '%s\n' "$updated" > "$manifest.tmp" && mv "$manifest.tmp" "$manifest"
fi
printf '%s\n' "$shim" > "$shim_path" && chmod 755 "$shim_path"

echo "$PACKAGE: ${previous:-not installed} -> $spec"
echo "wrote ./$SHIM_NAME"
echo
echo "Next: focus the Unity Editor (or just run ./$SHIM_NAME), then commit"
echo "  Packages/manifest.json Packages/packages-lock.json $SHIM_NAME"
echo
echo "Add this to AGENTS.md / CLAUDE.md:"
echo
printf '%s\n' "$snippet"
