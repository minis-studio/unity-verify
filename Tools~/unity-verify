#!/bin/bash
''':'
# Run a Unity project's EditMode tests and print a compact report.
#
#   unity-verify [--project-path PATH] [FILTER]
#
# The package's Editor code (Editor/*.cs) compiles the project, runs the tests
# and writes the report. This script only hands it a request through files in
# Library/UnityVerify (see Editor/Protocol.cs): to the Editor that has the
# project open, or else to a batch-mode Editor it starts for the run.
#
# Exit codes: 0 passed, 1 tests failed, 2 compile errors, 3 tooling or
# environment problem, 130 interrupted.
#
# Written for bash 3.2, which macOS ships. To python3 the file is one string plus
# the stub after `exit`, which hands over to bash, so callers that run it with
# python3 work too; the bash part avoids backslash escapes Python doesn't know.

set -u

PROTOCOL="unity-verify 1"
WARM_LIMIT=330    # seconds for compiling, reloading and testing in the open Editor
COLD_LIMIT=660    # seconds for importing, compiling and testing in a batch-mode Editor
SILENT_LIMIT=60   # seconds the open Editor may take to pick up a request
EXIT_ENVIRONMENT=3
EXIT_INTERRUPTED=130
NEWLINE='
'

usage() {
  echo "usage: unity-verify [--project-path PATH] [FILTER]"
}

help() {
  usage
  cat <<'EOF'

Compile the Unity project and run its EditMode tests, in the open Editor when
one has the project open, otherwise in a batch-mode Editor. With FILTER, run only
tests whose fixture or method name contains it (case-insensitive).

  --project-path PATH  Unity project root; defaults to the project containing
                       the working directory
  UNITY_EDITOR         Unity binary (or Unity.app) to use when no Editor is open;
                       defaults to the version in ProjectVersion.txt from Unity Hub
EOF
}

args_error() {
  usage >&2
  echo "ERR args; cause=$1; fix=run unity-verify [FILTER]" >&2
  exit "$EXIT_ENVIRONMENT"
}

filter=""
have_filter=0
project_path=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) help; exit 0 ;;
    --project-path)
      [ $# -ge 2 ] || args_error "--project-path needs a PATH"
      project_path=$2
      shift 2
      ;;
    --project-path=*) project_path=${1#*=}; shift ;;
    -*) args_error "unrecognized arguments: $1" ;;
    *)
      [ "$have_filter" = 0 ] || args_error "unrecognized arguments: $1"
      filter=$1
      have_filter=1
      shift
      ;;
  esac
done
case "$filter" in
  *"$NEWLINE"*) args_error "FILTER has a line break" ;;
esac

# The nearest Unity project at or above $1.
find_project() {
  local dir=$1
  while :; do
    if [ -d "$dir/Assets" ] && [ -f "$dir/ProjectSettings/ProjectVersion.txt" ]; then
      echo "$dir"
      return 0
    fi
    [ "$dir" = / ] && return 1
    dir=$(dirname "$dir")
  done
}

start=$(cd "${project_path:-.}" 2>/dev/null && pwd -P) || start=${project_path:-$PWD}
project=$(find_project "$start") || {
  echo "ERR project_missing; path=$start; fix=run inside a Unity project or pass --project-path" >&2
  exit "$EXIT_ENVIRONMENT"
}

box="$project/Library/UnityVerify"
requests="$box/requests"
responses="$box/responses"
mkdir -p "$requests" "$responses" || {
  echo "ERR library; path=$box; fix=check the project's Library folder" >&2
  exit "$EXIT_ENVIRONMENT"
}
# Answers for runs that were interrupted.
find "$responses" -type f -mtime +1 -exec rm -f {} + 2>/dev/null

id="$(date +%Y%m%d%H%M%S)-$$-$RANDOM"
request="$requests/$id.request"
state="$responses/$id.state"
response="$responses/$id.response"
log="$box/editor.log"
unity_pid=""

cleanup() {
  rm -f "$request" "$request.tmp" "$state" "$response"
}

stop_unity() {
  [ -n "$unity_pid" ] || return 0
  kill -TERM -- "-$unity_pid" 2>/dev/null
  local waited=0
  while kill -0 "$unity_pid" 2>/dev/null && [ "$waited" -lt 100 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done
  kill -KILL -- "-$unity_pid" 2>/dev/null
  wait "$unity_pid" 2>/dev/null
  unity_pid=""
}

trap cleanup EXIT
trap 'stop_unity; echo "ERR interrupted; fix=rerun" >&2; exit $EXIT_INTERRUPTED' INT TERM

write_request() {
  printf '%s\n%s\n' "$PROTOCOL" "$filter" > "$request.tmp" && mv "$request.tmp" "$request"
}

# Print the report in $response and return its exit code.
print_response() {
  local code
  {
    IFS= read -r code
    cat
  } < "$response"
  case "$code" in
    '' | *[!0-9]*) return "$EXIT_ENVIRONMENT" ;;
  esac
  return "$code"
}

# "editor PID" for an interactive Editor that has the project open, "batch PID"
# for a batch-mode one, nothing otherwise.
open_editor() {
  local pid command lower before rest path kind
  ps -axww -o pid=,command= 2>/dev/null | while read -r pid command; do
    case "$command" in
      *"/Unity "*) ;;
      *) continue ;;
    esac
    case "$command" in
      *AssetImportWorker*) continue ;;
    esac
    lower=$(printf '%s' "$command" | tr '[:upper:]' '[:lower:]')
    before=${lower%%"-projectpath "*}
    [ "$before" != "$lower" ] || continue
    rest=${command:$((${#before} + 13))}
    path=${rest%%" -"*}
    path=$(cd "$path" 2>/dev/null && pwd -P) || continue
    [ "$path" = "$project" ] || continue
    case "$lower" in
      *-batchmode*) kind=batch ;;
      *) kind=editor ;;
    esac
    echo "$kind $pid"
    break
  done
}

# The Unity binary for the project's Editor version, found the way Unity Hub
# finds installs. Prints the version and fails when there is none.
editor_binary() {
  if [ -n "${UNITY_EDITOR:-}" ]; then
    case "$UNITY_EDITOR" in
      *.app | *.app/) echo "${UNITY_EDITOR%/}/Contents/MacOS/Unity" ;;
      *) echo "$UNITY_EDITOR" ;;
    esac
    return 0
  fi
  local version hub install inner custom entry location candidate
  version=$(sed -n 's/^m_EditorVersion:[[:space:]]*//p' "$project/ProjectSettings/ProjectVersion.txt" | tr -d '\r ')
  case "$(uname -s)" in
    Darwin)
      hub="$HOME/Library/Application Support/UnityHub"
      install=/Applications/Unity/Hub/Editor
      inner=Unity.app/Contents/MacOS/Unity
      ;;
    *)
      hub="${XDG_CONFIG_HOME:-$HOME/.config}/UnityHub"
      install="$HOME/Unity/Hub/Editor"
      inner=Editor/Unity
      ;;
  esac
  # Unity Hub's install folder, when it was moved from the default.
  custom=$(head -n 1 "$hub/secondaryInstallPath.json" 2>/dev/null | tr -d '"\r')
  [ -n "$custom" ] && install=$custom
  if [ -x "$install/$version/$inner" ]; then
    echo "$install/$version/$inner"
    return 0
  fi
  # Editors added to Unity Hub from disk.
  entry=$(tr '{' '\n' < "$hub/editors-v2.json" 2>/dev/null | grep -F "\"version\":\"$version\"" | head -n 1)
  location=${entry#*'"location":["'}
  location=${location%%'"'*}
  if [ -n "$entry" ] && [ "$location" != "$entry" ]; then
    for candidate in "$location/Contents/MacOS/Unity" "$location/Editor/Unity" "$location"; do
      if [ -f "$candidate" ] && [ -x "$candidate" ]; then
        echo "$candidate"
        return 0
      fi
    done
  fi
  echo "$version"
  return 1
}

# Run in the Editor that has the project open (process $1).
warm() {
  local pid=$1 sent=$SECONDS beat
  write_request || return "$EXIT_ENVIRONMENT"
  while [ ! -f "$response" ]; do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "ERR editor_exited; pid=$pid; fix=rerun"
      return "$EXIT_ENVIRONMENT"
    fi
    if [ ! -f "$state" ] && [ $((SECONDS - sent)) -ge "$SILENT_LIMIT" ]; then
      beat=$(head -n 1 "$box/heartbeat" 2>/dev/null)
      if [ "$beat" = "$pid" ]; then
        echo "ERR editor_unresponsive; pid=$pid; cause=no Editor update for ${SILENT_LIMIT}s; fix=close dialogs in the Editor, or restart it"
      else
        echo "ERR editor_unprepared; pid=$pid; cause=the open Editor hasn't loaded dev.minis.unity-verify; fix=let it finish importing, check its Console for compile errors or Safe Mode, or close it"
      fi
      return "$EXIT_ENVIRONMENT"
    fi
    if [ $((SECONDS - sent)) -ge "$WARM_LIMIT" ]; then
      echo "ERR timeout; path=warm; state=$(head -n 1 "$state" 2>/dev/null || echo waiting); limit=${WARM_LIMIT}s; fix=check the Editor"
      return "$EXIT_ENVIRONMENT"
    fi
    sleep 0.1
  done
  print_response
}

# Run a batch-mode Editor on the request until it exits or COLD_LIMIT runs out.
# Returns Unity's exit code, or 124 on timeout.
launch() {
  local code
  # The Android module starts an adb server while the Editor loads, which takes
  # about 3s with adb's libusb backend on macOS and a fraction of that with the
  # native one. Nothing here talks to devices.
  set -m  # own process group, so Ctrl-C reaches only this script
  ADB_LIBUSB=${ADB_LIBUSB-0} "$editor" -batchmode -projectPath "$project" -logFile "$log" \
    -executeMethod UnityVerify.Batch.Run -unityVerifyRequest "$request" \
    < /dev/null > /dev/null 2>&1 &
  unity_pid=$!
  set +m
  while kill -0 "$unity_pid" 2>/dev/null; do
    if [ $((SECONDS - started)) -ge "$COLD_LIMIT" ]; then
      stop_unity
      return 124
    fi
    sleep 0.2
  done
  wait "$unity_pid"
  code=$?
  unity_pid=""
  return "$code"
}

# Compile errors in the log, in the Editor code's format: the compiler's
# file(line,column) lines, and assembly definition problems (duplicate names,
# cyclic dependencies), which Unity logs with the .asmdef path. Without repeats,
# with project-relative paths.
compile_errors() {
  {
    sed -n -E 's/^(.+)[(]([0-9]+),([0-9]+)[)]: error ([A-Za-z]+[0-9]+): (.*)$/\1:\2:\3 error \4: \5/p' "$log"
    grep -i -E 'assembly (definition|reference|has|with name)|cyclic (references?|dependenc)|duplicate references?|[.]asm(def|ref)' "$log" |
      grep -i -E 'error|exception|assembly (has|with name)|cyclic (references?|dependenc)|duplicate references?' |
      grep -v -E '^[^ ]+[(][0-9]+,[0-9]+[)]: |^-|LogAssemblyErrors' |
      while IFS= read -r line; do
        file=$(printf '%s\n' "$line" | grep -o -E '(Assets|Packages)/[^(),]*[.]asm(def|ref)' | head -n 1)
        line=${line#error: }
        echo "${file:+$file }error: $line"
      done
  } | tr -d '\r' | while IFS= read -r line; do echo "${line#"$project/"}"; done |
    sort -u | sort -t : -k 1,1f -k 2,2n -k 3,3n
}

# Start a batch-mode Editor for the run.
cold() {
  local editor started=$SECONDS code cause errors
  editor=$(editor_binary) || {
    echo "ERR editor_missing; version=$editor; fix=install it with Unity Hub, or set UNITY_EDITOR to the Unity binary"
    return "$EXIT_ENVIRONMENT"
  }
  write_request || return "$EXIT_ENVIRONMENT"
  launch
  code=$?
  if [ ! -f "$response" ] && [ "$code" != 124 ] && grep -q "Scripts have compiler errors" "$log" 2>/dev/null; then
    # Batch mode stops right after a failed compile, before any project code
    # (this package's included) loads, so the errors come from the log.
    errors=$(compile_errors)
    if [ -z "$errors" ]; then
      echo "ERR compile_verify; stage=cold; cause=Unity reports compilation errors but logged none it could read; log=Library/UnityVerify/editor.log; fix=check the log"
      return "$EXIT_ENVIRONMENT"
    fi
    echo "ERR compile_failed; errors=$(printf '%s\n' "$errors" | wc -l | tr -d ' '); tests=skipped"
    printf '%s\n' "$errors"
    return 2
  fi
  if [ "$code" = 124 ]; then
    echo "ERR tests_timeout; path=cold; limit=${COLD_LIMIT}s; log=Library/UnityVerify/editor.log; fix=check the log"
    return "$EXIT_ENVIRONMENT"
  fi
  if [ -f "$response" ]; then
    print_response
    return
  fi
  # Unity stopped before it ran the request.
  cause=$(sed -n '/Aborting batchmode due to failure:/{n;p;q;}' "$log" 2>/dev/null)
  [ -n "$cause" ] || cause=$(grep -m 1 '^executeMethod' "$log" 2>/dev/null)
  [ -n "$cause" ] || cause="Unity exited before running the tests"
  cause=$(printf '%s' "$cause" | tr ';' ',' | cut -c 1-160)
  echo "ERR unity_exited; code=$code; cause=$cause; log=Library/UnityVerify/editor.log; fix=check the log"
  return "$EXIT_ENVIRONMENT"
}

waited=0
while :; do
  found=$(open_editor)
  case "$found" in
    "editor "*) warm "${found#editor }"; exit $? ;;
    "batch "*)
      # Another batch-mode run has the project; wait for it.
      if [ "$waited" -ge "$COLD_LIMIT" ]; then
        echo "ERR project_busy; pid=${found#batch }; cause=a batch-mode Unity has the project open; fix=wait for it or stop it"
        exit "$EXIT_ENVIRONMENT"
      fi
      sleep 1
      waited=$((waited + 1))
      ;;
    *) cold; exit $? ;;
  esac
done
'''
import os, sys
os.execv("/bin/bash", ["/bin/bash", os.path.abspath(__file__)] + sys.argv[1:])
# '
