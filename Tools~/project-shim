#!/bin/bash
# unity-verify shim. Installed by dev.minis.unity-verify; commit it, don't edit it.
#
# Finds the dev.minis.unity-verify package for this project and runs its tool.
# The tool lives in the package's Tools~ folder, so the version a project runs
# is the version its Packages/manifest.json pins. This file only locates it: in
# Library/PackageCache once Unity has resolved the git dependency, or in a clone
# of the pinned tag until then.

set -u

package=dev.minis.unity-verify
tool="Tools~/unity-verify"
root=$(cd "$(dirname "$0")" && pwd -P)

# Newest resolved copy first.
found=$(ls -td "$root/Library/PackageCache/$package@"* 2>/dev/null | while IFS= read -r candidate; do
  if [ -f "$candidate/$tool" ]; then
    echo "$candidate"
    break
  fi
done)

if [ -z "$found" ]; then
  # Clone the pinned tag into a user cache, for checkouts Unity has not resolved yet.
  spec=$(grep -F "\"$package\"" "$root/Packages/manifest.json" 2>/dev/null | head -n 1 | cut -d '"' -f 4)
  url=${spec%%#*}
  tag=${spec#*#}
  case "$url" in
    *://*)
      if [ "$tag" != "$spec" ] && [ -n "$tag" ]; then
        cache="${XDG_CACHE_HOME:-$HOME/.cache}/unity-verify"
        found="$cache/$(echo "$tag" | tr / _)"
        if [ ! -f "$found/$tool" ]; then
          echo "unity-verify: fetching $spec into $cache" >&2
          mkdir -p "$cache" && staging=$(mktemp -d "$cache/.fetch.XXXXXX") || exit 3
          if ! git clone --quiet --depth 1 --branch "$tag" "$url" "$staging/checkout" 2> "$staging/error"; then
            cause=$(tail -n 1 "$staging/error" | tr ';' ',' | cut -c 1-160)
            rm -rf "$staging"
            echo "ERR package_fetch; pkg=$package; cause=${cause:-unknown}; fix=check network/git access, or open the project in Unity once" >&2
            exit 3
          fi
          [ -e "$found" ] || mv "$staging/checkout" "$found"
          rm -rf "$staging"
        fi
      fi
      ;;
  esac
fi

if [ -z "$found" ] || [ ! -f "$found/$tool" ]; then
  echo "ERR package_missing; pkg=$package; fix=add the package to Packages/manifest.json, open Unity once" >&2
  exit 3
fi
exec /bin/bash "$found/$tool" --project-path "$root" "$@"
